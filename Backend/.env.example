# Optional shell environment settings. The application does not auto-load .env files.
# Defaults use Backend/rps.sqlite3 and a locally generated Backend/.jwt-secret.
# Export these in your terminal only if you need to override the defaults.
# RPS_DATABASE_URL=sqlite:////absolute/path/to/rps.sqlite3
# RPS_SECRET_KEY=replace-with-a-random-secret-containing-at-least-32-characters
# RPS_PORT=8001
